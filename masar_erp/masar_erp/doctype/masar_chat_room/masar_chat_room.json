{
  "name": "MASAR Chat Room",
  "doctype": "DocType",
  "module": "MASAR ERP",
  "custom": 0,
  "autoname": "hash",
  "title_field": "title",
  "track_changes": 1,
  "field_order": ["title", "room_type", "company", "department", "enabled", "members"],
  "fields": [
    {"fieldname": "title", "fieldtype": "Data", "label": "Conversation name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "room_type", "fieldtype": "Select", "label": "Conversation type", "options": "Direct\nDepartment\nGroup", "default": "Group", "reqd": 1, "in_list_view": 1},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company"},
    {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department"},
    {"fieldname": "enabled", "fieldtype": "Check", "label": "Enabled", "default": "1"},
    {"fieldname": "members", "fieldtype": "Table", "label": "Members", "options": "MASAR Chat Room Member", "reqd": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 0, "report": 1, "export": 0, "share": 0, "print": 1, "email": 0}
  ]
}
